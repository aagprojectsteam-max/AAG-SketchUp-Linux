# Default deny: publish only reviewed documentation and original support sources.
/*
!/.gitignore
!/README.md
!/LICENSE
!/INSTALL.md
!/TROUBLESHOOTING.md
!/docs/
/docs/*
!/docs/*.md
!/docs/acceptance.json
!/docs/images/
/docs/images/*
!/docs/images/aa-before.png
!/docs/images/aa-4x.png
!/docs/images/aa-after.png
!/scripts/
/scripts/*
!/scripts/launch-sketchup.py
!/scripts/prepare-installation.py
!/scripts/install-launcher.py
!/scripts/collect-diagnostics.py
!/scripts/patch-wine-touch.py
!/scripts/check-publication.py
!/tests/
/tests/*
!/tests/test_launcher_validation.py
!/tests/test_wine_touch_patch.py

# Defense in depth: never version installation data or compiled output.
**/__pycache__/
*.pyc
*.exe
*.dll
*.msi
*.cab
*.dmp
*.skp
*.skb
*.reg
*.vdf
*.log
*.zip
*.tar*
.env*

# Reviewed plugin release sources and metadata.
!/artifacts/
/artifacts/*
!/scripts/pe_metadata.py
!/scripts/audit-plugins.py
!/scripts/migrate-plugin.py
!/scripts/popup-present.c
!/scripts/build-popup-helper.py
!/scripts/runtime-exec.py
!/tests/test_plugin_migration.py
!/tests/popup-present-smoke.c
!/docs/plugin-acceptance.json
!/artifacts/production-plugin-manifest.json

# Reviewed update tooling; proprietary candidates and private reports remain ignored.
!/config/
/config/*
!/docs/updates/
/docs/updates/*
!/scripts/prepare-update.py
!/tests/test_update_workflow.py
!/tests/update-model.rb
!/config/compatibility-rules.json
!/artifacts/current-golden-baseline.json
!/docs/update-framework-acceptance.json
!/docs/updates/TEMPLATE.md

# Original networking support only; generated trust stays private.
!/scripts/network-environment.py
!/tests/test_network_environment.py
!/scripts/network-trust.rb

# Trust and authentication artifacts remain local, including under docs.
*.pem
*.crt
*.key
*.p12
*.pfx
*cookies*.json
*session*.sqlite*

!/tests/network-probe.c
!/tests/network-wininet.c

!/docs/network-acceptance.json
